# Copy to .env and fill in for your deployment. `.env` is gitignored:
# never commit real hosts, paths or credentials.

POSTGRES_PASSWORD=change-me

# --- Least-privilege database roles (issue #5) -------------------------------
# The DDL train (the ingestion service) creates these two roles and re-issues
# their grants on every run. Set → the role is provisioned; unset or empty →
# it is skipped with a WARNING and no grant is issued (the dev/CI default).
#
#   vault_orchestrator  SELECT everywhere, INSERT on runs, INSERT/UPDATE on
#                       rag_ingestions, UPDATE (has_text_layer, page_count) on
#                       documents. For the off-host data-orchestrator.
#   vault_readonly      SELECT and nothing else. Used by the API (see
#                       compose.yaml) and by Metabase's analytics connection.
#
# Rotation: change the value here, run `docker compose run --rm ingestion`
# once, then update the consumer (the orchestrator's own .env, or Metabase's
# connection in the UI). The old password keeps working until that run.
#
# First boot: the API connects as vault_readonly, so on a brand-new cluster it
# crash-loops until the ingestion service has run once. That is deliberate and
# visible in `docker compose logs api`.
VAULT_ORCHESTRATOR_PASSWORD=change-me
VAULT_READONLY_PASSWORD=change-me

# --- Publishing Postgres on an interface (optional) --------------------------
# Only used once the `ports:` block in compose.yaml is uncommented — do that in
# the deployment's own compose (Dockge on the NAS), not in the repo.
#
# POSTGRES_BIND_ADDR MUST be one specific interface address: the tailnet IP of
# the host (POSTGRES_BIND_ADDR=<tailnet-ip>) when the off-host orchestrator
# must reach the vault, 127.0.0.1 otherwise. NEVER the all-zeroes wildcard
# address, and never drop the address: Docker publishes ports by DNAT ahead of
# the host firewall, so this value is the whole access control. The real
# address belongs in this host's .env only — never in the repo.
# POSTGRES_BIND_PORT is the host-side port, for a machine where 5432 is taken.
#POSTGRES_BIND_ADDR=127.0.0.1
#POSTGRES_BIND_PORT=5432

# Host directories (absolute paths on the machine running compose)
POSTGRES_DATA_DIR=/path/to/vault/postgres-data
METABASE_DATA_DIR=/path/to/vault/metabase-data

# corpus data (read-only mounts). MANIFEST_DIR is the corpus data/ ROOT, not
# data/manifest: the ingester scans manifest/*.jsonl recursively and reads
# cadence.jsonl, runs.jsonl and discovery_errors.jsonl at the root (the other
# root-level producer files are skipped by name).
MANIFEST_DIR=/path/to/central-bank-corpus/data
RAW_DIR=/path/to/central-bank-corpus/data/raw

# Optional. Override the location of a root-level producer file (default:
# $MANIFEST_DIR/<name>.jsonl inside the container).
#CADENCE_PATH=
#RUNS_PATH=
#DISCOVERY_ERRORS_PATH=

# Optional. Torn-share guard: skip the soft-delete sweep when more than
# this fraction of live rows would disappear at once (default 0.05).
# Set to 1.0 to force a legitimate large deletion wave through.
#SWEEP_MAX_DELETE_FRACTION=0.05

# Optional. Torn-read guard on the discovery-error trail: leave
# discovery_errors untouched when the file holds fewer than this fraction of
# the fingerprints already stored for the corpus (default 0.5). The producer
# never truncates, so a shrink is a torn read; set to 0.0 for one run to
# accept a legitimate rotation.
#DISCOVERY_ERRORS_MIN_RETAIN_FRACTION=0.5

# Optional. Cut discovery-error messages at this many characters before they
# reach the `error` column (default 2000).
#DISCOVERY_ERROR_MAX_CHARS=2000

# Optional. Corpus label this ingestion service applies to manifests that
# do not carry their own "corpus" field (default: central-bank). A second
# corpus = a second ingestion service block with its own manifest mount
# and CORPUS value.
#CORPUS=central-bank
